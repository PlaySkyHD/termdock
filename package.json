{
  "name": "termdock",
  "private": true,
  "version": "0.0.0",
  "description": "Persistent workspace and terminal manager for Windows (WSL-first).",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm test --workspaces --if-present",
    "openspec": "openspec"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.2.7"
  }
}
