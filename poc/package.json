{
  "name": "termdock-poc",
  "private": true,
  "version": "0.0.0",
  "description": "Phase-0-Proof-of-Concept: WSL-tmux-Reattach, xterm.js, zwei Fenster mit exklusivem Eingaberecht. Nicht Teil der Workspaces.",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "start": "electron .",
    "self-test": "electron . --self-test",
    "check:reattach": "node scripts/reattach-check.mjs",
    "check:reattach:electron-node": "node scripts/run-as-electron-node.mjs scripts/reattach-check.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "electron": "45.3.1"
  }
}
